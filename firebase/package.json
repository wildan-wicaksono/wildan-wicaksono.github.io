{
  "name": "wildan-blog-comments",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build-comments.mjs",
    "test": "firebase emulators:exec --only firestore --project demo-homepage-comments 'node --test tests/firestore.test.mjs tests/adapter.test.mjs tests/migration.test.mjs'",
    "import:comments": "node scripts/import-comments.mjs",
    "export:comments": "node scripts/export-discussions.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "esbuild": "0.28.2",
    "firebase-tools": "13.35.1"
  }
}
